# STAGING environment — SALIN ke .env.local / GitHub Secrets (JANGAN commit nilai asli).
# Project Supabase STAGING yang TERPISAH dari production. Lihat docs/ci-cd-staging.md.

# --- Server ---
PORT=4000

# --- Database staging (pooler URL dari Supabase staging project) ---
DATABASE_URL="postgresql://postgres.<STAGING_REF>:<password>@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<STAGING_REF>:<password>@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres"

# --- Auth (boleh beda dari production — PREFER beda) ---
JWT_SECRET="<generate: openssl rand -hex 32>"
JWT_EXPIRES_IN="7d"

# --- Supabase Storage staging ---
SUPABASE_URL="https://<STAGING_REF>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="<service_role key dari staging project>"
SUPABASE_BUCKET="avatars"

# --- E2E safety guards ---
ALLOW_DB_RESET="true"                      # WAJIB untuk E2E (truncate) — HANYA di staging
E2E_STAGING_PROJECT_REF="<STAGING_REF>"    # project ref yang harus ada di DATABASE_URL
# PRODUCTION_DATABASE_HOST="<host db prod>"   # blocklist — isi agar guard makin ketat
# PRODUCTION_SUPABASE_URL="<prod url>"        # blocklist

# --- Payment (sandbox staging) ---
PJP_PROVIDER="xendit"
XENDIT_SECRET_KEY=""
XENDIT_CALLBACK_TOKEN=""
MIDTRANS_SERVER_KEY=""
MIDTRANS_IS_PRODUCTION="false"

# --- AI service (opsional, default localhost) ---
AI_SERVICE_URL="http://localhost:8000"

# --- Google Sign-In (opsional untuk test) ---
GOOGLE_CLIENT_ID=""
